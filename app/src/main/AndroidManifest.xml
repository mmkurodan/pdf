<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Reading input files uses SAF (no permission needed). Writing output to
        the public Download folder uses MediaStore on Android 10+ (no permission);
        only Android 9 and below need WRITE_EXTERNAL_STORAGE, so it is capped at
        API 28.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Only used for the optional, one-time OCR model (traineddata) download.
         After download, OCR runs fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- OCR API server: an always-on foreground service. specialUse (not dataSync)
         because dataSync is time-limited on Android 15+ and cannot start at boot. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Sticky notification = the user-visible "server running" indicator (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Listing LAN endpoints while excluding the cellular address. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keep CPU + Wi-Fi awake while a request is being recognised (screen off). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Bring the API back after a reboot when it was left enabled. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the user exempt the app from battery optimization (system dialog, on user
         action only) so the server keeps serving in Doze and the watchdog may restart it. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Package visibility (Android 11+) for the companion LLM Tester app, so its
         launch intent/service can be resolved from the LLM settings screen. -->
    <queries>
        <package android:name="com.micklab.llama" />
    </queries>

    <application
        android:name=".PdfToolsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.PdfTools">

        <!-- AdMob アプリ ID（未設定だと MobileAds 初期化時にクラッシュ） -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3062461524889254~1542365697" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PdfTools">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OCR API foreground service. Exported so other apps can switch the API on/off:
             explicit Intent to this component with action com.micklab.pdf.START_SERVICE
             (optional int extra "port") or com.micklab.pdf.STOP_SERVICE. -->
        <service
            android:name=".api.OcrApiService"
            android:foregroundServiceType="specialUse"
            android:exported="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local_ocr_api_server" />
        </service>

        <!-- Invisible trampoline: other apps launch it (explicit Intent, action
             com.micklab.pdf.START_SERVICE, optional int extra "port") when an OEM
             "AutoLaunch" block refuses the direct cross-app service start. -->
        <activity
            android:name=".api.ApiStartActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Re-assert a persisted "API enabled" intent after a device reboot. -->
        <receiver
            android:name=".api.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Watchdog alarm target: restarts the service after a kill/crash. Only our own
             AlarmManager PendingIntent triggers it. -->
        <receiver
            android:name=".api.WatchdogReceiver"
            android:exported="false" />

        <!-- Exposes generated files (shared PDFs/images/JSON) to other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            WorkManager is initialized on-demand through Hilt
            (Configuration.Provider on the Application), so the default
            automatic initializer is removed here.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
